#!/usr/bin/env bash
# Suite uji dijalankan DI SINI, bukan di GitHub.
#
# KENAPA ADA. Sejak 17 September 2026 satu-satunya yang berjalan di GitHub
# adalah parser PowerShell -- tidak ada gerbang lain. Yang menahan kode rusak
# sampai ke origin karena itu hook ini, bukan permintaan di AGENTS.md, karena
# permintaan bukan penjaga.
#
# Batasnya jujur: `git push --no-verify` melewatinya. Hook ini menahan
# kecelakaan, bukan niat.
set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
cd "$ROOT" || exit 0
[ -d test ] || exit 0

RED=$'\033[31m'; GREEN=$'\033[32m'; DIM=$'\033[2m'; NC=$'\033[0m'

# Hanya ref yang BENAR-BENAR membawa kode baru yang perlu diuji.
#
# Penghapusan branch tidak mengirim apa pun: SHA lokalnya nol.
#
# Tag juga tidak, ASAL commit yang ditunjuknya sudah ada di remote -- itu kasus
# `git push origin vX.Y.Z` sesudah `git push origin main`, dan commitnya sudah
# diuji beberapa detik sebelumnya. Sampai 17 September 2026 hook ini menjalankan
# seluruh suite untuk mendorong satu objek tag 207 byte: tiga menit menunggu
# tanpa satu pun kepastian baru.
#
# Tag yang menunjuk commit yang BELUM terdorong justru membawa kodenya, jadi ia
# tetap diuji. Begitu pula bila keadaan remote tidak bisa dipastikan dari sini --
# ragu berarti menguji, bukan melewati.
remote="${1:-origin}"
ada_kode=0
while read -r lref lsha _rref _rsha; do
    [ -z "${lsha:-}" ] && continue
    # SHA nol = penghapusan.
    case "$lsha" in *[!0]*) ;; *) continue ;; esac
    case "$lref" in
        refs/tags/*)
            commit="$(git rev-parse -q --verify "${lsha}^{commit}" 2>/dev/null)" || commit=""
            if [ -n "$commit" ] &&
               git merge-base --is-ancestor "$commit" "refs/remotes/$remote/HEAD" 2>/dev/null; then
                continue
            fi
            if [ -n "$commit" ] &&
               git merge-base --is-ancestor "$commit" "refs/remotes/$remote/main" 2>/dev/null; then
                continue
            fi
            ;;
    esac
    ada_kode=1
done
[ "$ada_kode" = 0 ] && exit 0

# scripts/pr.sh baru saja menjalankannya untuk commit ini. Menjalankan ulang
# suite yang sama demi push yang sama hanya menambah tiga menit tanpa menambah
# satu pun kepastian.
if [ "${COOPER_UJI_SUDAH:-}" = "$(git rev-parse HEAD)" ]; then
    echo "${DIM}pre-push: suite sudah dijalankan pr.sh untuk commit ini${NC}"
    exit 0
fi

. "$ROOT/scripts/lib/uji_lokal.sh" || exit 0
TMP="$(mktemp)"; trap 'rm -f "$TMP"' EXIT
echo "${DIM}pre-push: menjalankan suite uji lokal${NC}"
if uji_lokal_jalankan "$TMP"; then
    echo "${GREEN}✔${NC} suite hijau — push dilanjutkan"
    exit 0
fi
echo
echo "${RED}✘ PUSH DITOLAK${NC} — ada uji yang merah di atas."
echo "  Perbaiki dulu, atau ${DIM}git push --no-verify${NC} bila Anda memang tahu sebabnya."
exit 1
