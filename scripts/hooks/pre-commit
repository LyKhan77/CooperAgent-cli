#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Commit Hook: Secret Leakage & Quality Prevention
# ==============================================================================
set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
NC='\033[0m'

echo "🔍 Memeriksa commit untuk potensi kebocoran rahasia (secret scan)..."

# 1. Regex pattern untuk API keys, private keys, passwords
SECRET_PATTERNS="(AIzaSy[0-9A-Za-z_-]{33}|sk-[a-zA-Z0-9]{20,}|ghp_[a-zA-Z0-9]{36}|BEGIN RSA PRIVATE KEY|BEGIN OPENSSH PRIVATE KEY|AKIA[0-9A-Z]{16})"

# Cari di file yang sedang di-stage (kecuali file ignore/sample/docs/hooks itu sendiri)
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -vE '(\.gitkeep|sample|example|test/results|scripts/hooks)' || true)

if [ -n "$STAGED_FILES" ]; then
    for FILE in $STAGED_FILES; do
        if [ -f "$FILE" ]; then
            if grep -Eq "$SECRET_PATTERNS" "$FILE"; then
                echo -e "${RED}✖ COMMIT DITOLAK:${NC} Ditemukan potensi hardcoded secret/API key di: ${YELLOW}$FILE${NC}"
                echo -e "${YELLOW}Gunakan environment variable (.env) dan jangan commit credential ke repository.${NC}"
                exit 1
            fi
        fi
    done
fi

echo -e "${GREEN}✔ Secret scan lolos.${NC}"

# ==============================================================================
# 2. Changelog Gate (Lapis 3 penegakan)
#    Menolak commit yang mengubah kode tanpa mencatat apa yang berubah.
#    Ini satu-satunya lapisan yang tidak bergantung pada kepatuhan model.
#
#    State per-sesi TIDAK lagi disimpan di repo: itu lokal per mesin
#    (~/.grok/memory/ untuk Grok CLI). Yang wajib terbagi hanyalah catatan
#    perubahan dan analisis — lihat docs/harness_scope.md.
# ==============================================================================
CODE_RE='\.(py|ts|tsx|js|jsx|rs|go|java|kt|c|cc|cpp|h|hpp|sh|ps1|sql|toml|yaml|yml)$'
MEM_RE='^(CHANGELOG\.md|docs/)'

CODE_STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$CODE_RE" | grep -vE '^(scripts/hooks/|test/results/)' || true)
MEM_STAGED=$(git diff --cached --name-only --diff-filter=ACMR | grep -E "$MEM_RE" || true)

if [ -n "$CODE_STAGED" ] && [ -z "$MEM_STAGED" ]; then
    N=$(echo "$CODE_STAGED" | wc -l)
    echo -e "${RED}✖ COMMIT DITOLAK:${NC} ${N} file kode di-stage, tetapi CHANGELOG.md/docs/ tidak diperbarui."
    echo -e "${YELLOW}Perubahan kode wajib disertai catatan apa yang berubah dan buktinya.${NC}"
    echo ""
    echo -e "  File kode yang di-stage:"
    echo "$CODE_STAGED" | sed 's/^/    - /' | head -10
    echo ""
    echo -e "  ${GREEN}Perbaiki dengan:${NC}"
    echo -e "    1. Tambahkan entri di CHANGELOG.md (skill /init-changelog)"
    echo -e "       Wajib: Konteks, Perubahan (path lengkap), Bukti, Dampak, Rollback"
    echo -e "       Untuk analisis panjang, tulis di docs/plans/ dan rujuk dari changelog"
    echo -e "    2. git add CHANGELOG.md   (atau docs/)"
    echo -e "    3. commit ulang"
    echo ""
    echo -e "  ${YELLOW}Bypass darurat:${NC} git commit --no-verify  (wajib dijelaskan di pesan commit)"
    exit 1
fi

if [ -n "$MEM_STAGED" ]; then
    echo -e "${GREEN}✔ CooperxMemory checkpoint terdeteksi.${NC}"
fi

echo -e "${GREEN}✔ Semua gerbang lolos. Melanjutkan commit.${NC}"
exit 0
